  "episodes": {
    "1": [
      {
        "airDate": "2026-11-06",
        "episodeNumber": 1,
        "name": "Encroachment",
        "overview": "Actual Magic is the world's first fulldive VRMMORPG, and Class 6-1 of Yukihana Elementary School has been invited to playtest it. Yuma, Sawa, Konken, and Nagi form a party and head into a dungeon to take down its boss. Though the battle ends in success, they realize that there is no way to log out of the game. The lines between the game and reality begin to blur. What does Yuma see when he awakes?",
        "stillPath": "/9u7aphLw8Mw44OKCjjiCJ6coL7g.jpg",
        "voteAverage": 7
      },
      {
        "airDate": "2026-11-06",
        "episodeNumber": 2,
        "name": "Transformation",
        "overview": "Yuma awakes in the real world to see his classmate Watamaki transformed in ways that defy reality. She attacks Yuma, but Konken and Sawa come to his aid. Sawa tells Yuma to launch Actual Magic, and he discovers that their game stats are in effect in the real world. They use magic to subdue Watamaki, but Yuma is determined not to harm a fellow classmate.",
        "stillPath": "/y0MCOYVDN6xbQKts7zmaojKC9W9.jpg",
        "voteAverage": 7
      },
      {
        "airDate": "2026-11-13",
        "episodeNumber": 3,
        "name": "Awakening",
        "overview": "Having captured Watamaki, Yuma and the others head to Altea's lobby on the first floor. There, they find the members of Class 6-1, who have been cornered by a large monster known as a Conehead Bruiser. The three take on the creature to save their classmates. Though at first their strategy seems to be working, their victory is foiled, and they must find a way to fight without MP or weapons.",
        "stillPath": "/1OhPfE0IlzwcdsSYtkBnQ4LJ5vG.jpg",
        "voteAverage": 7
      },
      {
        "airDate": "2026-11-20",
        "episodeNumber": 4,
        "name": "Suspicion",
        "overview": "Yuma and friends are reunited with their classmates, but Sugamo, the class rep, suspects them of being monsters. Yuma's explanations about Beroshi's death, Watamaki's transformation, and how they neutralized Watamaki without killing her only raise Sugamo's suspicions further. Eventually, he convinces Ohno and teaches everyone how to use Actual Magic, but another threat approaches.",
        "stillPath": "/rWPRKTIZfe0SqXkT7Ulp2TCVriF.jpg",
        "voteAverage": 7
      },
