  "episodes": {
    "64": [
      {
        "airDate": "2026-03-18",
        "episodeNumber": 1,
        "name": "Fluke Rebuke",
        "overview": "In the appetizer round, a peculiar cereal is the strangest find in the basket. Then, when one of the chefs begins cooking her fluke fillets very late in the round, the judges wonder whether they will be happy with the results. The entrée round mystery basket ingredients run the gamut from light to hearty, and the finalists must work a clever crepe and an interactive candy into their desserts.",
        "stillPath": "/hZvA9XqnkWh47TfpddaCJLTKXHl.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-03-25",
        "episodeNumber": 2,
        "name": "Ted's Takeover",
        "overview": "Ted's in charge of the baskets! In the first round, he challenges the chefs with a wildly unusual product in a tube and his favorite snack of all time. The final basket includes an exotic extract and an Italian dessert that Ted can never pass up.",
        "stillPath": "/7P91DTcq8cR0t4PhsyHIJBP6nbN.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-04-01",
        "episodeNumber": 3,
        "name": "Venison Valor",
        "overview": "An over-reduced sauce and undercooked venison are potential problems in the first round. Then, with Mexican chocolate in the dessert basket, it seems like the judges are in for a treat, but one of the chef's time management woes are worrying.",
        "stillPath": "/wCxmiTyVK23qOiq6J4M1C94IMp2.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-04-08",
        "episodeNumber": 4,
        "name": "African Soul",
        "overview": "Four chefs with a connection to the rich culinary history of Africa cook with passion in this special competition. Ambition abounds in the first round as the chefs endeavor to hammer out exceptional saltfish appetizers. Goat chops test the chefs' chops in the entrée round, and a final basket that skews more savory than sweet presents a unique challenge for the final two competitors.",
        "stillPath": "/AsxfHSQU7jps3hbk3EvTeO1ZBKi.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-04-15",
        "episodeNumber": 5,
        "name": "Eggscuse Me",
        "overview": "The chef who cracks the code on this special competition's egg-centric baskets will win $10,000! Three others will leave with egg on their faces. Delicate eggs and smoked seafood are part of the appetizer round challenge. A strange syrup and bold greens must be included in the competitors' entrée plates, and breaking open a giant egg should be the first item on the finalists' to-do list in the dessert round.",
        "stillPath": "/eLpv4rgNC1AF12t9T3WetPnZaH8.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-04-22",
        "episodeNumber": 6,
        "name": "Indigenous Inspiration",
        "overview": "For this special competition, Native American chefs who revere indigenous culinary traditions compete in a first-of-its-kind battle. Every basket is packed with ingredients known and loved in native communities, like sumac and whitefish for the first round. The judges look forward to tasting entrées featuring a lean, tasty protein. Then, when the dessert round turns into a baking battle, will both chefs have enough time to complete their dishes as planned?",
        "stillPath": "/hKQ8F9prdrjdzMXPb1T110VbVgA.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-04-29",
        "episodeNumber": 7,
        "name": "Sea Bean Bonanza",
        "overview": "Ready, set, cook! In the appetizer round, a super salty veggie and a dried fruit make up half of the chefs' basket riddle. In the entrée round, a carnival treat meets a Tex-Mex staple in the form of a strange mashup basket ingredient. Then, when a tight competition culminates in the dessert round, both chefs come up with ideas for creative cakes, but will they both be able to execute them?",
        "stillPath": "/imKcOodMeqPT4MQjq14O8V6l8jp.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-05-06",
        "episodeNumber": 8,
        "name": "Leftovers Gone Wild!",
        "overview": "Making amazing meals out of absolutely anything is this competition's modus operandi, so leftovers is an all-time favorite Chopped theme. In the appetizer round, everyone is excited to show they have what it takes to repurpose foods that might have otherwise been tossed out, and the judges are in for four interesting takes on the first basket. In the entrée round, the chefs attempt to impress the judges using a variety of tools and techniques. The two finalists open the dessert basket to find a single slice of birthday cake, but only one chef will be left celebrating at the end of this leftovers battle.",
        "stillPath": null,
        "voteAverage": 0
      }
    ]
