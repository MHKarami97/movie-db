  "episodes": {
    "1": [
      {
        "airDate": "2026-10-18",
        "episodeNumber": 1,
        "name": "Episode 1",
        "overview": "Lana finds in Fares something she's never quite found before. But as they grow closer, more people begin inserting themselves into her life, and Majd acts as though he already has a claim on it.",
        "stillPath": "/8ZqTJFMYwJSwI1AeqlBQVj19ZaP.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-18",
        "episodeNumber": 2,
        "name": "Episode 2",
        "overview": "The more certain Lana becomes about Fares, the harder others push in the opposite direction. And while she stands by her choice, Majd begins treating rejection as a problem to be solved.",
        "stillPath": "/7znNd6nyp95U2qH1sYQkxY4sPQE.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-18",
        "episodeNumber": 3,
        "name": "Episode 3",
        "overview": "With an infinity tattoo sealing the promise between them, Lana and Fares see their future as all but written. But when Majd gains the upper hand, the forever they envisioned becomes someone else's to bargain with.",
        "stillPath": "/6Kdtnfg59XwHOUQwNQCL7xpB4Tw.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-18",
        "episodeNumber": 4,
        "name": "Episode 4",
        "overview": "Lana has spent years looking back. Fares is back in the city with no intention of doing the same. As their paths cross under very different circumstances, the advantage no longer lies where it once did.",
        "stillPath": "/qJIyp6dfJt8xQCYY9HoFbF864xw.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-18",
        "episodeNumber": 5,
        "name": "Episode 5",
        "overview": "Time has done little to weaken the pull between Lana and Fares. But while neither can move on, circumstances refuse to budge, and Maya begins questioning a story that no longer quite adds up.",
        "stillPath": "/wQbxozBGqCgcdfrLUl6h4FGRByq.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-18",
        "episodeNumber": 6,
        "name": "Episode 6",
        "overview": "Loose ends from the past become harder to ignore once everyone starts comparing notes. As Majd looks for answers, long-held assumptions grow harder to sustain, and a carefully maintained narrative begins to fray.",
        "stillPath": "/pmA3P3PAq4B9TRCoMY83IGYOySR.jpg",
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-19",
        "episodeNumber": 7,
        "name": "Episode 7",
        "overview": "As Lana and Fares find new reasons to stay close, long-standing loyalties come under strain. And when people start acting on partial truths, good intentions could prove just as dangerous as bad ones.",
        "stillPath": null,
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-19",
        "episodeNumber": 8,
        "name": "Episode 8",
        "overview": "A future that never came to pass begins drawing Lana and Fares back into its orbit. Elsewhere, Majd doubles down on a claim he refuses to relinquish, no matter the cost.",
        "stillPath": null,
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-19",
        "episodeNumber": 9,
        "name": "Episode 9",
        "overview": "Some things are harder to let go of once they finally seem within reach. For Majd, that only makes them worth fighting harder for.",
        "stillPath": null,
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-19",
        "episodeNumber": 10,
        "name": "Episode 10",
        "overview": "The line between commitment and coercion grows harder to ignore. And as Lana and Fares find themselves back where they left off, certain versions of the past begin demanding their due.",
        "stillPath": null,
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-19",
        "episodeNumber": 11,
        "name": "Episode 11",
        "overview": "Nothing expands its reach quite like the fear of losing what was never freely given. Some arrangements, in particular, survive not because they are accepted, but because the alternatives are made unthinkable.",
        "stillPath": null,
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-19",
        "episodeNumber": 12,
        "name": "Episode 12",
        "overview": "Some nights cast shadows long after everyone involved appears to have moved on. The longer that one night is examined, the less it resembles the story everyone involved learned to live with.",
        "stillPath": null,
        "voteAverage": 0
      },
      {
        "airDate": "2026-10-20",
        "episodeNumber": 13,
        "name": "Episode 13",
        "overview": "Competing interests have a way of drawing everyone into the equation. And once enough people have something to lose, remaining impartial becomes an exorbitant luxury.",
        "stillPath": null,
        "voteAverage": 0
      },
